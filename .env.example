# ========================================================
# Webtop Custom - Environment Configuration
# ========================================================

# Hostname da maquina
HOSTNAME=cloud-vps

# Fuso horario
TZ=America/Sao_Paulo

# Idioma da interface
LANG=pt_BR.UTF-8
LANGUAGE=pt_BR:pt
LC_ALL=pt_BR.UTF-8

# Titulo da aba do navegador
TITLE=Cloud Desktop

# Usuario e Senha da Tela de Login (Windows Style)
CUSTOM_USER=Admin
PASSWORD=AltereSuaSenha123!

# Portas de Acesso no Host
PORT_HTTP=3000
PORT_HTTPS=3001

# Permissoes de usuario interno (UID/GID)
PUID=1000
PGID=1000
