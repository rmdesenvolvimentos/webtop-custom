# ========================================================
# Webtop Custom - Environment Configuration
# ========================================================

# Hostname da maquina
HOSTNAME=cloud-vps

# Fuso horario
TZ=America/Sao_Paulo

# Idioma da interface (Exemplos: pt_BR.UTF-8 / it_IT.UTF-8 / en_US.UTF-8 / es_ES.UTF-8 / de_DE.UTF-8 / fr_FR.UTF-8)
LANG=pt_BR.UTF-8
LANGUAGE=pt_BR:pt

# Titulo da aba do navegador
TITLE=Cloud Desktop

# Usuario e Senha da Tela de Login (Windows 11 Style)
# Recomendado: altere para uma senha forte com numeros e caracteres especiais
CUSTOM_USER=Admin
PASSWORD=AltereSuaSenhaForte123!

# Portas de Acesso no Host
# Porta 80 (HTTP) e 443 (HTTPS) permitem que qualquer usuario acesse direto
# pelo IP da VPS no navegador (sem precisar digitar :porta na URL)
PORT_HTTP=80
PORT_HTTPS=443

# Permissoes de usuario interno (UID/GID)
PUID=1000
PGID=1000

# Armazenamento Persistente (/DATA / Disco D:)
# Se nao definido, o Docker cria e usa a pasta local ./data/storage automaticamente.
# Se sua VPS possuir uma particao ou pasta /DATA no host, voce pode definir:
# DATA_PATH=/DATA
DATA_PATH=./data/storage
